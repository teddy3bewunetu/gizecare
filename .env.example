# Google Calendar OAuth — identifies the GizeCare desktop app (same for all users).
# Each user still signs in with their own Google account; tokens stay on their machine.
#
# Copy to `.env` and fill in values from Google Cloud Console (Desktop OAuth client).
# See docs/google_calendar_setup.md and docs/gmail_setup.md (same OAuth client).

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Telegram Client API (my.telegram.org) — Linux + libtdjson
# See docs/telegram_setup.md
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_TDLIB_PATH="/home/teddy3/code/my projects/build/td/build/libtdjson.so"

# Slack OAuth (api.slack.com) — user token, Linux loopback :8766
# See docs/slack_setup.md
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
